# URL pública da API + sufixo /api. Obrigatória no build de produção (Vercel),
# porque a API roda em outro projeto/domínio.
#   ex.: https://kaizen-api.vercel.app/api
# Em desenvolvimento deixe VAZIA: o proxy do Vite encaminha /api para :3333.
VITE_API_URL=

# Usadas apenas na recuperação de senha (Supabase Auth). Opcionais.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
