# ─── Banco de dados ────────────────────────────────────────────────
# Conexão PostgreSQL usada pelo Prisma (schema/seed)
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_REF].supabase.co:5432/postgres"

# ─── Supabase (PostgREST) ──────────────────────────────────────────
# A API usa Supabase para todas as operações de banco.
# Encontre em: Supabase Dashboard → Settings → API
SUPABASE_URL="https://[SEU_REF].supabase.co"
SUPABASE_SERVICE_KEY="[service_role_key]"
# Opcional — sem ela o sistema usa o service key como fallback (RLS por usuário desativado).
SUPABASE_ANON_KEY="[anon_key]"

# ─── Autenticação ─────────────────────────────────────────────────
# Segredo usado para assinar o JWT da aplicação.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# ─── Frontend ─────────────────────────────────────────────────────
# Usada no link de redefinição de senha.
FRONTEND_URL="http://localhost:5173"

# ─── IA (classificação assistida - B13) ───────────────────────────
# Opcionais. Sem nenhuma chave o sistema não classifica automaticamente e as
# questões entram sem sugestão (o professor classifica na revisão).
# GEMINI_API_KEY tem prioridade e é a ÚNICA que habilita a importação de
# questões a partir de imagens (extração multimodal).
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ─── Owner ────────────────────────────────────────────────────────
# Email tratado como admin/root da plataforma.
OWNER_EMAIL=""

# ─── Uploads ──────────────────────────────────────────────────────
# Teto do arquivo enviado na importação, em MB. Na Vercel NÃO passe de 4:
# a plataforma corta o corpo da requisição em ~4,5 MB antes de chegar na
# function. Em host de processo longo (Railway/Render) pode subir.
UPLOAD_MAX_MB="4"

# ─── CORS (previews da Vercel) ────────────────────────────────────
# Cada deploy de preview da Vercel ganha um subdomínio novo, que nunca bate com
# FRONTEND_URL. Defina "true" apenas se precisar testar previews no navegador.
ALLOW_VERCEL_PREVIEW_ORIGINS="false"
